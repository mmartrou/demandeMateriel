# Variables d'environnement

# Base de données PostgreSQL (obligatoire en production, Neon)
# Sans DATABASE_URL, l'appli utilise une base SQLite locale (data/material_requests.db)
DATABASE_URL=postgresql://user:password@host:5432/database

# Configuration Flask
FLASK_ENV=production
PORT=8080
FLASK_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
SESSION_COOKIE_SECURE=true
MAX_UPLOAD_MB=10

# Auth Google (obligatoire)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_WORKSPACE_DOMAIN=etablissement.fr

# Admin unique
ADMIN_EMAIL=prenom.nom@etablissement.fr

# Mapping email Google -> enseignant (nom EXACT de la table teachers)
# Format JSON sur une seule ligne
# Exemple:
# {"prenom.nom@etablissement.fr":"Nom"}
TEACHER_EMAIL_MAP={"prenom.nom@etablissement.fr":"Nom","autre.prof@etablissement.fr":"Autre Nom"}

# Développement local uniquement (jamais sur le serveur) : active /dev-login, connexion sans Google
# DEV_LOGIN=1
